# ============================================
# NFT Creator v2 — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER share your .env file or commit it to git.
# Add .env to your .gitignore.
# ============================================

# ─── Required for deployment & on-chain interaction ───

# Your wallet private key.
# You can paste it with or without 0x prefix — the skill will auto-normalize it.
# SECURITY: Fill this in the file directly. Do NOT paste it in chat.
PRIVATE_KEY=

# ─── Required for IPFS upload (Pinata SDK) ───

# Pinata JWT token.
# How to get it:
#   1. Go to https://app.pinata.cloud → sign up / log in
#   2. Left sidebar → "API Keys" → "New Key"
#   3. Name it anything (e.g. "nft-builder"), leave default permissions
#   4. Click "Create Key" → copy the JWT value (the long string starting with "eyJ...")
#   5. Paste it below
PINATA_JWT=

# Pinata Gateway URL (for verifying uploads via HTTP)
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ─── Network (auto-configured by skill, do NOT edit) ───
# The skill knows Pharos RPC URLs internally.
# You will choose the network (testnet/mainnet) during configuration.
